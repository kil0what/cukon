# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMTP settings for sending lead notifications to the client email (zukonar@mail.ru)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@цукон.рф"

# Admin panel password (defaults to tsukon2026 if unset)
CMS_ADMIN_PASSWORD=""
